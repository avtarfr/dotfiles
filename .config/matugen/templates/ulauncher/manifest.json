{
  "manifest_version": "1",
  "name": "matugen",
  "display_name": "Matugen Material",
  "extend_theme": "light",
  "css_file": "theme.css",
  "css_file_gtk_3.20+": "theme.css",
  "matched_text_hl_colors": {
