#!/usr/bin/env bash
# Switchwall: Hyprland wallpaper changer and Material You / Matugen theme sync
set -euo pipefail

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
STATE_DIR="$XDG_STATE_HOME/matugen"
MATUGEN_SCRIPTS="$XDG_CONFIG_HOME/matugen/scripts"
MATUGEN_VENV="${MATUGEN_VIRTUAL_ENV:-$STATE_DIR/.venv}"
WALLPAPERS_DIR="$HOME/Pictures/wallpapers"
RESTORE_SCRIPT="$XDG_CONFIG_HOME/hypr/custom/scripts/__restore_video_wallpaper.sh"
THUMBNAIL_DIR="$XDG_CONFIG_HOME/hypr/custom/scripts/mpvpaper_thumbnails"

VIDEO_OPTS="no-audio loop hwdec=auto scale=bilinear interpolation=no video-sync=display-resample panscan=1.0 video-scale-x=1.0 video-scale-y=1.0 video-align-x=0.5 video-align-y=0.5 load-scripts=no"

is_video() {
    local ext="${1##*.}"
    ext="$(echo "$ext" | tr '[:upper:]' '[:lower:]')"
    [[ "$ext" =~ ^(mp4|webm|mkv|avi|mov)$ ]]
}

choose_gui() {
    local selected=""
    local search_dir="$WALLPAPERS_DIR"
    if [ ! -d "$search_dir" ]; then
        search_dir="$HOME/Pictures"
    fi

    # Priority 1: Yazi in dedicated floating modal (renders full image previews in Kitty)
    if [ "${FORCE_GUI:-false}" != true ] && command -v yazi &>/dev/null && command -v kitty &>/dev/null; then
        local tmp
        tmp="$(mktemp)"
        YAZI_CONFIG_HOME="$HOME/.config/xdg-desktop-portal-termfilechooser/yazi" \
        YAZI_CHOOSER_OUT="$tmp" \
        kitty --class=wallpaper-modal --title="Choose wallpaper" \
              -o initial_window_width=1100 -o initial_window_height=700 \
              yazi --chooser-file="$tmp" "$search_dir" 2>/dev/null || true
        if [ -s "$tmp" ]; then
            selected="$(cat "$tmp" | head -n 1)"
        fi
        rm -f "$tmp"
        echo "$selected"
        return 0
    fi

    # Priority 2: Zenity GTK picker
    if command -v zenity &>/dev/null; then
        selected=$(zenity --file-selection \
            --filename="$search_dir/" \
            --title="Choose wallpaper" \
            --file-filter="Wallpapers (Images/Videos) | *.jpg *.jpeg *.png *.webp *.avif *.mp4 *.webm *.mkv" \
            --file-filter="All Files | *" 2>/dev/null || true)
    elif command -v kdialog &>/dev/null; then
        selected=$(kdialog --getopenfilename "$search_dir" "Images (*.png *.jpg *.jpeg *.webp *.avif);;Videos (*.mp4 *.webm *.mkv)" --title "Choose wallpaper" 2>/dev/null || true)
    fi

    echo "$selected"
}

get_random_wallpaper() {
    local search_dir="$WALLPAPERS_DIR"
    if [ ! -d "$search_dir" ]; then
        search_dir="$HOME/Pictures"
    fi

    find "$search_dir" -maxdepth 2 -type f \( \
        -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o \
        -iname "*.webp" -o -iname "*.avif" -o -iname "*.mp4" -o \
        -iname "*.webm" \
    \) 2>/dev/null | shuf -n 1
}

TARGET=""
RANDOM_MODE=false
MODE_OVERRIDE=""
FORCE_GUI=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        -r|--random)
            RANDOM_MODE=true
            shift
            ;;
        -g|--gui)
            FORCE_GUI=true
            shift
            ;;
        -m|--mode)
            MODE_OVERRIDE="$2"
            shift 2
            ;;
        -h|--help)
            echo "Usage: $(basename "$0") [OPTIONS] [IMAGE_OR_VIDEO_PATH]"
            echo ""
            echo "Options:"
            echo "  -r, --random       Pick a random wallpaper from $WALLPAPERS_DIR"
            echo "  -m, --mode <mode>  Force dark or light mode (default: system preference)"
            echo "  -h, --help         Show this help message"
            echo ""
            echo "If run without arguments, an interactive file chooser dialog is opened."
            exit 0
            ;;
        *)
            if [[ -z "$TARGET" ]]; then
                TARGET="$1"
            fi
            shift
            ;;
    esac
done

if [ "$RANDOM_MODE" = true ]; then
    TARGET="$(get_random_wallpaper)"
elif [ -z "$TARGET" ]; then
    TARGET="$(choose_gui)"
fi

if [ -z "$TARGET" ]; then
    echo "No wallpaper selected. Aborting."
    exit 0
fi

# Expand path if needed
TARGET="$(realpath "$TARGET" 2>/dev/null || readlink -f "$TARGET" 2>/dev/null || echo "$TARGET")"

if [ ! -f "$TARGET" ]; then
    echo "Error: File '$TARGET' not found." >&2
    exit 1
fi

echo "Setting wallpaper: $TARGET"
mkdir -p "$STATE_DIR/user/generated/wallpaper" "$THUMBNAIL_DIR"

COLOR_SOURCE="$TARGET"

if is_video "$TARGET"; then
    pkill -f -9 mpvpaper || true

    mkdir -p "$(dirname "$RESTORE_SCRIPT")"
    cat > "$RESTORE_SCRIPT" << EOF
#!/bin/bash
# Generated by switchwall - Don't modify directly.
pkill -f -9 mpvpaper 2>/dev/null || true
for monitor in \$(hyprctl monitors -j | jq -r '.[] | .name'); do
    mpvpaper -o "$VIDEO_OPTS" "\$monitor" "$TARGET" &
    sleep 0.1
done
EOF
    chmod +x "$RESTORE_SCRIPT"

    for monitor in $(hyprctl monitors -j | jq -r '.[] | .name'); do
        mpvpaper -o "$VIDEO_OPTS" "$monitor" "$TARGET" &
        sleep 0.1
    done

    # Generate first-frame thumbnail for theming & lockscreen
    COLOR_SOURCE="$THUMBNAIL_DIR/$(basename "$TARGET").jpg"
    ffmpeg -y -i "$TARGET" -vframes 1 "$COLOR_SOURCE" 2>/dev/null || true
    if [ ! -f "$COLOR_SOURCE" ]; then
        COLOR_SOURCE="$TARGET"
    fi
else
    # Static image: kill mpvpaper if active
    pkill -f -9 mpvpaper 2>/dev/null || true

    # Clear restore script
    mkdir -p "$(dirname "$RESTORE_SCRIPT")"
    cat > "$RESTORE_SCRIPT" << 'EOF'
#!/bin/bash
# Reset by switchwall.
EOF
    chmod +x "$RESTORE_SCRIPT"

    # Write persistent hyprpaper config
    cat > "$XDG_CONFIG_HOME/hypr/hyprpaper.conf" << EOF
wallpaper {
    monitor = 
    path = $TARGET
    fit_mode = cover
}

splash = false
ipc = true
EOF

    # Apply live to hyprpaper
    if pgrep -x hyprpaper >/dev/null; then
        hyprctl hyprpaper wallpaper ",$TARGET,cover" 2>/dev/null || true
    else
        nohup hyprpaper >/dev/null 2>&1 &
    fi
fi

# Update symlink for hyprlock
ln -sf "$COLOR_SOURCE" "$XDG_CONFIG_HOME/hypr/current_wallpaper"

# Determine system dark/light mode
MODE="$MODE_OVERRIDE"
if [ -z "$MODE" ]; then
    CURRENT_MODE=$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null | tr -d "'" || echo "prefer-dark")
    if [[ "$CURRENT_MODE" == "prefer-dark" ]]; then
        MODE="dark"
    else
        MODE="light"
    fi
fi

# 1. Matugen color generation (updates hyprland, hyprlock, gtk, swaync, fuzzel, color.txt, path.txt)
if command -v matugen &>/dev/null; then
    matugen --source-color-index 0 --mode "$MODE" image "$COLOR_SOURCE" 2>/dev/null || \
    matugen --source-color-index 0 image "$COLOR_SOURCE" 2>/dev/null || true
fi

# Write target path to path.txt
echo "$TARGET" > "$STATE_DIR/user/generated/wallpaper/path.txt"

# 2. Material color SCSS & terminal theme generation
if [ -f "$MATUGEN_VENV/bin/python3" ] && [ -f "$MATUGEN_SCRIPTS/generate_colors_material.py" ]; then
    "$MATUGEN_VENV/bin/python3" "$MATUGEN_SCRIPTS/generate_colors_material.py" \
        --path "$COLOR_SOURCE" \
        --termscheme "$MATUGEN_SCRIPTS/terminal/scheme-base.json" \
        --blend_bg_fg \
        --mode "$MODE" \
        > "$STATE_DIR/user/generated/material_colors.scss" 2>/dev/null || true
fi

# 3. Apply terminal colors to Kitty & escape sequences
if [ -f "$MATUGEN_SCRIPTS/applycolor.sh" ]; then
    "$MATUGEN_SCRIPTS/applycolor.sh" 2>/dev/null || true
fi

# 4. Background auxiliary hooks
if [ -f "$XDG_CONFIG_HOME/matugen/templates/kde/kde-material-you-colors-wrapper.sh" ]; then
    "$XDG_CONFIG_HOME/matugen/templates/kde/kde-material-you-colors-wrapper.sh" &>/dev/null &
fi

if [ -f "$MATUGEN_SCRIPTS/code/material-code-set-color.sh" ]; then
    "$MATUGEN_SCRIPTS/code/material-code-set-color.sh" &>/dev/null &
fi

# 5. Reload Hyprland to update border highlights
hyprctl reload &>/dev/null || true

# 6. Notify user
if command -v notify-send &>/dev/null; then
    notify-send -a "Wallpaper" -i "$COLOR_SOURCE" "Wallpaper Updated" "$(basename "$TARGET")" 2>/dev/null || true
fi

echo "Wallpaper switched successfully."
