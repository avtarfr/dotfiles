# Generate formatted table for fzf
list_table() {
    get_data | awk -F'\t' '
    {
        printf "%-32s │ %-10s │ %s\n", $1, "["$2"]", $3
    }'
}

# Preview pane renderer for a specific keybinding
render_preview() {
    local query="${1:-}"
    if [[ -z "$query" ]]; then
        echo "No keybind selected"
        return
    fi

    # Strip column padding to extract key name
    local key
    key="$(echo "$query" | awk -F'│' '{gsub(/^[ \t]+|[ \t]+$/, "", $1); print $1}')"

    local match
    match="$(get_data | grep -F "$key"$'\t' | head -n1 || true)"

    if [[ -z "$match" ]]; then
        # Try matching by full query if key lookup failed
        match="$(get_data | grep -F "$key" | head -n1 || true)"
    fi

    if [[ -z "$match" ]]; then
        echo "Details not found for: $key"
        return
    fi

    IFS=$'\t' read -r k_key k_cat k_action k_cmd k_src k_details <<< "$match"

    local c_cyan="\033[36m"
    local c_green="\033[32m"
    local c_bold="\033[1m"
    local c_dim="\033[90m"
    local c_yellow="\033[33m"
    local c_reset="\033[0m"

    echo -e "${c_cyan}┌── Keybind Inspector ──────────────────────────────────────────┐${c_reset}"
    printf "│ %bKeys:%b        %b%-45s%b │\n" "$c_bold" "$c_reset" "$c_green" "$k_key" "$c_reset"
    printf "│ %bCategory:%b    %-45s │\n" "$c_bold" "$c_reset" "$k_cat"
    printf "│ %bAction:%b      %-45s │\n" "$c_bold" "$c_reset" "$k_action"
    printf "│ %bConfig:%b      %-45s │\n" "$c_bold" "$c_reset" "$k_src"
    echo -e "${c_cyan}├───────────────────────────────────────────────────────────────┤${c_reset}"
    echo -e "│ ${c_bold}Execution Command:${c_reset}"
    echo "$k_cmd" | fold -s -w 60 | while IFS= read -r line; do
        printf "│   %b%-58s%b │\n" "$c_yellow" "$line" "$c_reset"
    done
    echo -e "${c_cyan}├───────────────────────────────────────────────────────────────┤${c_reset}"
    echo -e "│ ${c_bold}Description & Usage:${c_reset}"
    echo "$k_details" | fold -s -w 60 | while IFS= read -r line; do
        printf "│   %-58s │\n" "$line"
    done
    echo -e "${c_cyan}└───────────────────────────────────────────────────────────────┘${c_reset}"
}

# Execute command associated with selected keybinding
execute_keybind() {
    local line="${1:-}"
    if [[ -z "$line" ]]; then return; fi

    local key
    key="$(echo "$line" | awk -F'│' '{gsub(/^[ \t]+|[ \t]+$/, "", $1); print $1}')"

    local cmd
    cmd="$(get_data | grep -F "$key"$'\t' | head -n1 | cut -f4 || true)"

    if [[ -n "$cmd" ]]; then
        eval "$cmd" >/dev/null 2>&1 &
    fi
}

# Yank key combination or command
yank_item() {
    local line="${1:-}"
    local mode="${2:-key}" # 'key' or 'cmd'
    if [[ -z "$line" ]]; then return; fi

    local key
    key="$(echo "$line" | awk -F'│' '{gsub(/^[ \t]+|[ \t]+$/, "", $1); print $1}')"

    local item
    if [[ "$mode" == "cmd" ]]; then
        item="$(get_data | grep -F "$key"$'\t' | head -n1 | cut -f4 || true)"
    else
        item="$key"
    fi

    if [[ -n "$item" ]]; then
        echo -n "$item" | wl-copy
        notify-send -a "Cheatsheet" "Copied to clipboard" "$item" -t 1500 2>/dev/null || true
    fi
}

# Open configuration files in editor
open_config() {
    ~/.config/hypr/hyprland/scripts/launch_first_available.sh \
        "code ~/.config/hypr/hyprland/keybinds.lua ~/.config/hypr/custom/keybinds.lua" \
        "kate ~/.config/hypr/hyprland/keybinds.lua ~/.config/hypr/custom/keybinds.lua" \
        "xdg-open ~/.config/hypr/hyprland/keybinds.lua" >/dev/null 2>&1 &
}

# Subcommand dispatch
case "${1:-}" in
    --preview)
        render_preview "${2:-}"
        exit 0
        ;;
    --exec)
        execute_keybind "${2:-}"
        exit 0
        ;;
    --yank)
        yank_item "${2:-}" "${3:-key}"
        exit 0
        ;;
    --edit)
        open_config
        exit 0
        ;;
esac

header=$'\033[1;36mHyprland Keybinds Cheatsheet\033[0m  \033[90m│  Fuzzy filter: type any key or category\033[0m\n\033[90m[Enter] Run command │ [Ctrl+Y] Copy key │ [Ctrl+C] Copy cmd │ [Ctrl+E] Edit lua\033[0m'

selected="$(list_table | fzf \
    --ansi \
    --reverse \
    --border=rounded \
    --border-label=" Hyprland Keybinds " \
    --border-label-pos=2 \
    --prompt=" Search > " \
    --header="$header" \
    --preview="$SCRIPT_PATH --preview {}" \
    --preview-window="right:52%:wrap" \
    --bind="enter:execute-silent($SCRIPT_PATH --exec {})+abort" \
    --bind="ctrl-y:execute-silent($SCRIPT_PATH --yank {} key)" \
    --bind="ctrl-c:execute-silent($SCRIPT_PATH --yank {} cmd)" \
    --bind="ctrl-e:execute-silent($SCRIPT_PATH --edit)" \
    --no-sort \
    || true)"
