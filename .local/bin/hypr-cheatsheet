#!/usr/bin/env bash
# Hyprland Interactive Keybinds Cheatsheet
# High-performance, categorized TUI modal powered by fzf

set -euo pipefail

SCRIPT_PATH="$(realpath "$0")"

# Database of all Hyprland keybindings
# Format: KEY | CATEGORY | ACTION | COMMAND | SOURCE | DETAILS
get_data() {
