#!/usr/bin/env bash
set -euo pipefail

# Dependencies: fzf, nmcli, bluetoothctl, rfkill, column
SELF="$(readlink -f "$0")"

# -----------------------------------------------------------------------------
# Color Palette (ANSI-C Escapes) & Theme
# -----------------------------------------------------------------------------
C_RESET=$'\033[0m'
C_BOLD=$'\033[1m'
C_DIM=$'\033[2;37m'
C_GREEN=$'\033[1;32m'
C_YELLOW=$'\033[1;33m'
C_CYAN=$'\033[1;36m'
C_BLUE=$'\033[1;34m'
C_RED=$'\033[1;31m'
C_MAGENTA=$'\033[1;35m'

FZF_THEME=(
  --ansi
  --border=rounded
  --border-label-pos=2
  --layout=reverse
  --inline-info
  --prompt=" ❯ "
  --pointer="▶"
  --marker="✔"
  --color="border:#585b70,label:#89b4fa,header:#cdd6f4,prompt:#f38ba8,pointer:#f5e0dc,info:#a6adc8,hl:#f38ba8,hl+:#a6e3a1"
)

# -----------------------------------------------------------------------------
# Internal Subcommands: Scanners & Inspectors
# -----------------------------------------------------------------------------

scan_wifi() {
  if [ "$(nmcli -t -f WIFI g 2>/dev/null)" != "enabled" ]; then
    printf "  STATE│SSID│SIGNAL│SECURITY│BSSID\n"
    printf "  %b○%b│[Wi-Fi radio is disabled]│-│-│-\n" "$C_DIM" "$C_RESET"
    return
  fi

  (
    printf "%b  STATE│SSID│SIGNAL│SECURITY│BSSID%b\n" "$C_BOLD" "$C_RESET"
    nmcli -t -f IN-USE,BSSID,SSID,SIGNAL,BARS,SECURITY dev wifi list --rescan auto 2>/dev/null | \
      sed 's/\\:/-/g' | \
      awk -F: -v G="$C_GREEN" -v Y="$C_YELLOW" -v R="$C_RED" -v C="$C_CYAN" -v D="$C_DIM" -v RST="$C_RESET" '
        $3 != "" || $2 != "" {
          b = $2
          gsub(/-/, ":", b)
          ssid = ($3 != "" ? $3 : "<Hidden>")
          st = ($1 == "*" ? G "● active" RST : D "○       " RST)

          sig_val = $4 + 0
          sig_col = (sig_val >= 70 ? G : (sig_val >= 40 ? Y : R))
          sig_str = sig_col sprintf("%3d%% %-4s", sig_val, $5) RST

          sec_str = ($6 != "" ? C $6 RST : D "Open" RST)

          printf "  %s│%s│%s│%s│%s%s%s\n", st, ssid, sig_str, sec_str, D, b, RST
        }
      '
  ) | column -t -s '│' -o ' │ '
}

preview_wifi() {
  local raw_input="${1:-}"
  local bssid
  bssid=$(echo "$raw_input" | grep -o -E '([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}' || true)

  if [ -z "$bssid" ]; then
    printf "${C_DIM}Select an access point from the list to view details.${C_RESET}\n"
    return
  fi

  local data
  data=$(nmcli -m multiline -f BSSID,SSID,MODE,CHAN,FREQ,RATE,SIGNAL,BARS,SECURITY,ACTIVE dev wifi list bssid "$bssid" 2>/dev/null | head -n10 || true)
  get_val() {
    echo "$data" | grep -E "^$1:" | sed "s/^[^:]*:[[:space:]]*//" | head -n1
  }

  local ssid chan freq rate sig bars sec act
  ssid=$(get_val "SSID")
  chan=$(get_val "CHAN")
  freq=$(get_val "FREQ")
  rate=$(get_val "RATE")
  sig=$(get_val "SIGNAL")
  bars=$(get_val "BARS")
  sec=$(get_val "SECURITY")
  act=$(get_val "ACTIVE")

  local sig_num filled empty bar_fill bar_empty sig_color
  sig_num=${sig:-0}
  filled=$(( sig_num / 10 ))
  [ "$filled" -gt 10 ] && filled=10
  empty=$(( 10 - filled ))
  bar_fill=$(printf "%0.s█" $(seq 1 $filled 2>/dev/null) || true)
  bar_empty=$(printf "%0.s░" $(seq 1 $empty 2>/dev/null) || true)

  if [ "$sig_num" -ge 70 ]; then
    sig_color="$C_GREEN"
  elif [ "$sig_num" -ge 40 ]; then
    sig_color="$C_YELLOW"
  else
    sig_color="$C_RED"
  fi

  printf "${C_BOLD}╭── Access Point Inspector ─────────╮${C_RESET}\n"
  printf "  ${C_DIM}SSID      :${C_RESET} ${C_BOLD}%s${C_RESET}\n" "${ssid:-<Hidden>}"
  printf "  ${C_DIM}BSSID     :${C_RESET} %s\n" "$bssid"

  if [ "$act" = "yes" ]; then
    printf "  ${C_DIM}Status    :${C_RESET} ${C_GREEN}● Connected (Active)${C_RESET}\n"
  elif [ -n "$ssid" ] && nmcli -t -f NAME connection show 2>/dev/null | grep -Fxq "$ssid"; then
    printf "  ${C_DIM}Status    :${C_RESET} ${C_CYAN}○ Saved Profile${C_RESET}\n"
  else
    printf "  ${C_DIM}Status    :${C_RESET} ${C_DIM}○ Available (New)${C_RESET}\n"
  fi

  printf "  ${C_DIM}Security  :${C_RESET} ${C_YELLOW}%s${C_RESET}\n" "${sec:-Open}"
  printf "  ${C_DIM}Signal    :${C_RESET} %s[%s%s] %s%%%s (%s)\n" "$sig_color" "$bar_fill" "$bar_empty" "$sig_num" "$C_RESET" "$bars"
  printf "  ${C_DIM}Frequency :${C_RESET} %s (Channel %s)\n" "${freq:-N/A}" "${chan:-N/A}"
  printf "  ${C_DIM}Max Rate  :${C_RESET} %s\n" "${rate:-N/A}"
  printf "${C_BOLD}╰───────────────────────────────────╯${C_RESET}\n"

  if [ "$act" = "yes" ]; then
    local wlan_dev ip gw dns
    wlan_dev=$(nmcli -t -f DEVICE,TYPE dev 2>/dev/null | grep ':wifi$' | cut -d: -f1 | head -n1)
    ip=$(nmcli -t -f IP4.ADDRESS dev show "$wlan_dev" 2>/dev/null | cut -d: -f2 | head -n1)
    gw=$(nmcli -t -f IP4.GATEWAY dev show "$wlan_dev" 2>/dev/null | cut -d: -f2)
    dns=$(nmcli -t -f IP4.DNS dev show "$wlan_dev" 2>/dev/null | cut -d: -f2 | paste -sd", " -)
    printf "\n${C_BOLD}╭── Active IP Configuration ────────╮${C_RESET}\n"
    printf "  ${C_DIM}Interface :${C_RESET} %s\n" "${wlan_dev:-wlan0}"
    printf "  ${C_DIM}IPv4 Addr :${C_RESET} ${C_GREEN}%s${C_RESET}\n" "${ip:-None}"
    printf "  ${C_DIM}Gateway   :${C_RESET} %s\n" "${gw:-None}"
    printf "  ${C_DIM}DNS       :${C_RESET} %s\n" "${dns:-None}"
    printf "${C_BOLD}╰───────────────────────────────────╯${C_RESET}\n"
  fi
}

scan_bt() {
  if ! bluetoothctl show 2>/dev/null | grep -q "Powered: yes"; then
    printf "  STATE│MAC ADDRESS│DEVICE NAME\n"
    printf "  %b○ Power Off%b│-│-\n" "$C_DIM" "$C_RESET"
    return
  fi

  (
    printf "%b  STATE│MAC ADDRESS│DEVICE NAME%b\n" "$C_BOLD" "$C_RESET"
    bluetoothctl devices 2>/dev/null | while read -r _ mac name; do
      info=$(bluetoothctl info "$mac" 2>/dev/null || true)
      if echo "$info" | grep -q "Connected: yes"; then
        st="${C_GREEN}● Connected${C_RESET}"
      elif echo "$info" | grep -q "Paired: yes"; then
        st="${C_CYAN}○ Paired   ${C_RESET}"
      else
        st="${C_DIM}○ Seen     ${C_RESET}"
      fi
      printf "  %s│%s%s%s│%s\n" "$st" "$C_DIM" "$mac" "$C_RESET" "$name"
    done
  ) | column -t -s '│' -o ' │ '
}

preview_bt() {
  local raw_input="${1:-}"
  local mac
  mac=$(echo "$raw_input" | grep -o -E '([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}' || true)

  if [ -z "$mac" ]; then
    printf "${C_DIM}Select a Bluetooth device to inspect properties.${C_RESET}\n"
    return
  fi

  local info name alias conn paired trusted blocked icon battery
  info=$(bluetoothctl info "$mac" 2>/dev/null || true)
  name=$(echo "$info" | grep -E "^\s*Name:" | sed 's/^\s*Name:\s*//')
  alias=$(echo "$info" | grep -E "^\s*Alias:" | sed 's/^\s*Alias:\s*//')
  conn=$(echo "$info" | grep -E "^\s*Connected:" | sed 's/^\s*Connected:\s*//')
  paired=$(echo "$info" | grep -E "^\s*Paired:" | sed 's/^\s*Paired:\s*//')
  trusted=$(echo "$info" | grep -E "^\s*Trusted:" | sed 's/^\s*Trusted:\s*//')
  blocked=$(echo "$info" | grep -E "^\s*Blocked:" | sed 's/^\s*Blocked:\s*//')
  icon=$(echo "$info" | grep -E "^\s*Icon:" | sed 's/^\s*Icon:\s*//')
  battery=$(echo "$info" | grep -E "^\s*Battery Percentage:" | sed 's/^\s*Battery Percentage:\s*//' || true)

  printf "${C_BOLD}╭── Bluetooth Device Inspector ─────╮${C_RESET}\n"
  printf "  ${C_DIM}Name      :${C_RESET} ${C_BOLD}%s${C_RESET}\n" "${name:-$alias}"
  printf "  ${C_DIM}Address   :${C_RESET} %s\n" "$mac"
  printf "  ${C_DIM}Type/Icon :${C_RESET} %s\n" "${icon:-generic}"
  printf "  ${C_DIM}Connected :${C_RESET} %s\n" "$([ "$conn" = "yes" ] && echo "${C_GREEN}Yes${C_RESET}" || echo "${C_DIM}No${C_RESET}")"
  printf "  ${C_DIM}Paired    :${C_RESET} %s\n" "$([ "$paired" = "yes" ] && echo "${C_CYAN}Yes${C_RESET}" || echo "${C_DIM}No${C_RESET}")"
  printf "  ${C_DIM}Trusted   :${C_RESET} %s\n" "$([ "$trusted" = "yes" ] && echo "${C_GREEN}Yes${C_RESET}" || echo "${C_DIM}No${C_RESET}")"
  printf "  ${C_DIM}Blocked   :${C_RESET} %s\n" "$([ "$blocked" = "yes" ] && echo "${C_RED}Yes${C_RESET}" || echo "${C_DIM}No${C_RESET}")"
  if [ -n "$battery" ]; then
    printf "  ${C_DIM}Battery   :${C_RESET} ${C_GREEN}%s%%%s\n" "$battery" "$C_RESET"
  fi
  printf "${C_BOLD}╰───────────────────────────────────╯${C_RESET}\n"
}

preview_main() {
  local rf_state="OFF"
  if rfkill list all 2>/dev/null | grep -q "Soft blocked: yes"; then
    rf_state="ON"
  fi

  local wifi_radio
  wifi_radio=$(nmcli -t -f WIFI g 2>/dev/null || echo "off")

  local active_ssid
  active_ssid=$( (nmcli -t -f ACTIVE,SSID dev wifi 2>/dev/null | grep "^yes:" | cut -d: -f2 | head -n1) || true)

  local wlan_dev ip
  wlan_dev=$( (nmcli -t -f DEVICE,TYPE dev 2>/dev/null | grep ':wifi$' | cut -d: -f1 | head -n1) || true)
  ip=$( (nmcli -t -f IP4.ADDRESS dev show "${wlan_dev:-wlan0}" 2>/dev/null | cut -d: -f2 | head -n1) || true)

  local eth_dev eth_state="Disconnected"
  eth_dev=$( (nmcli -t -f DEVICE,TYPE dev 2>/dev/null | grep ':ethernet$' | cut -d: -f1 | head -n1) || true)
  if [ -n "$eth_dev" ]; then
    eth_state=$( (nmcli -t -f DEVICE,STATE dev 2>/dev/null | grep "^$eth_dev:" | cut -d: -f2) || echo "down")
  fi

  local bt_pwr="Powered Off" bt_dev=""
  if bluetoothctl show 2>/dev/null | grep -q "Powered: yes"; then
    bt_pwr="Powered On"
    bt_dev=$( (bluetoothctl devices Connected 2>/dev/null | cut -d' ' -f3- | head -n1) || true)
  fi

  local vpn_active
  vpn_active=$( (nmcli -t -f TYPE,NAME connection show --active 2>/dev/null | grep -E '^(vpn|wireguard):' | cut -d: -f2 | paste -sd, -) || true)

  local bat_cap bat_stat bat_icon
  bat_cap=$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -n1 || echo "N/A")
  bat_stat=$(cat /sys/class/power_supply/BAT*/status 2>/dev/null | head -n1 || echo "Unknown")

  local mic_mute mic_vol
  mic_mute=$(pactl get-source-mute @DEFAULT_SOURCE@ 2>/dev/null | awk '{print $2}')
  mic_vol=$(wpctl get-volume @DEFAULT_SOURCE@ 2>/dev/null | awk '{print int($2*100)"%"}')

  local out_vol out_mute
  out_vol=$(wpctl get-volume @DEFAULT_SINK@ 2>/dev/null | awk '{print int($2*100)"%"}')
  out_mute=$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | awk '{print $2}')

  local load_avg mem_used mem_total mem_pct
  load_avg=$(cut -d' ' -f1-3 /proc/loadavg 2>/dev/null || echo "N/A")
  mem_used=$(free -m 2>/dev/null | awk '/Mem:/ {print $3}')
  mem_total=$(free -m 2>/dev/null | awk '/Mem:/ {print $2}')
  mem_pct=$(( mem_used * 100 / mem_total ))

  printf "${C_BOLD}╭── System Hardware & Power ────────╮${C_RESET}\n"
  printf "  ${C_DIM}Battery       :${C_RESET} %s%% (%s)\n" "$bat_cap" "$bat_stat"
  printf "  ${C_DIM}Microphone    :${C_RESET} %s (Vol: %s)\n" "$([ "$mic_mute" = "yes" ] && echo "${C_RED}MUTED${C_RESET}" || echo "${C_GREEN}ACTIVE${C_RESET}")" "${mic_vol:-N/A}"
  printf "  ${C_DIM}Audio Out     :${C_RESET} %s (Vol: %s)\n" "$([ "$out_mute" = "yes" ] && echo "${C_RED}MUTED${C_RESET}" || echo "${C_GREEN}ACTIVE${C_RESET}")" "${out_vol:-N/A}"
  printf "  ${C_DIM}Memory        :${C_RESET} %sMB / %sMB (%s%%)\n" "$mem_used" "$mem_total" "$mem_pct"
  printf "  ${C_DIM}CPU Load      :${C_RESET} %s\n" "$load_avg"
  printf "${C_BOLD}╰───────────────────────────────────╯${C_RESET}\n\n"

  printf "${C_BOLD}╭── System Network Overview ────────╮${C_RESET}\n"
  printf "  ${C_DIM}Airplane Mode :${C_RESET} %s\n" "$([ "$rf_state" = "ON" ] && echo "${C_YELLOW}[BLOCKED]${C_RESET}" || echo "${C_GREEN}[UNBLOCKED]${C_RESET}")"
  printf "  ${C_DIM}Wi-Fi Radio   :${C_RESET} %s\n" "$([ "$wifi_radio" = "enabled" ] && echo "${C_GREEN}Enabled${C_RESET}" || echo "${C_RED}Disabled${C_RESET}")"
  printf "  ${C_DIM}Connected AP  :${C_RESET} %s\n" "$([ -n "$active_ssid" ] && echo "${C_GREEN}$active_ssid${C_RESET}" || echo "${C_DIM}None${C_RESET}")"
  printf "  ${C_DIM}Interface IP  :${C_RESET} %s\n" "${ip:-None}"
  printf "  ${C_DIM}Ethernet      :${C_RESET} %s (%s)\n" "${eth_dev:-None}" "$eth_state"
  printf "  ${C_DIM}Bluetooth     :${C_RESET} %s%s\n" "$bt_pwr" "$([ -n "$bt_dev" ] && echo " ($bt_dev)" || echo "")"
  printf "  ${C_DIM}Active VPN    :${C_RESET} %s\n" "${vpn_active:-None}"
  printf "  ${C_DIM}Keep-Awake    :${C_RESET} %s\n" "$([ ! pidof hypridle >/dev/null 2>&1 ] && echo "${C_GREEN}ACTIVE (No Sleep)${C_RESET}" || echo "${C_DIM}Inactive (Sleep ON)${C_RESET}")"
  printf "${C_BOLD}╰───────────────────────────────────╯${C_RESET}\n\n"

  printf "${C_BOLD}╭── Hardware Radio States ──────────╮${C_RESET}\n"
  rfkill list 2>/dev/null | awk -v G="$C_GREEN" -v Y="$C_YELLOW" -v D="$C_DIM" -v RST="$C_RESET" '
    /^[0-9]+:/ { name=$2; sub(/:$/, "", name) }
    /Soft blocked:/ {
      st = ($3 == "yes" ? Y "Blocked  " RST : G "Unblocked" RST)
      printf "  %s%-18s:%s %s\n", D, name, RST, st
    }
  '
  printf "${C_BOLD}╰───────────────────────────────────╯${C_RESET}\n"
}

# -----------------------------------------------------------------------------
# Internal Subcommand Dispatcher
# -----------------------------------------------------------------------------
case "${1:-}" in
  __scan_wifi)        scan_wifi; exit 0 ;;
  __preview_wifi)     preview_wifi "${2:-}"; exit 0 ;;
  __scan_bt)          scan_bt; exit 0 ;;
  __preview_bt)       preview_bt "${2:-}"; exit 0 ;;
  __preview_main)     preview_main "${2:-}"; exit 0 ;;
  __build_main_table) ;; # handled after definition
esac

# -----------------------------------------------------------------------------
# Interactive Submenus
# -----------------------------------------------------------------------------

manage_wifi() {
  if [ "$(nmcli -t -f WIFI g 2>/dev/null)" != "enabled" ]; then
    printf "${C_YELLOW}Enabling Wi-Fi adapter...${C_RESET}\n"
    nmcli radio wifi on
    sleep 1
  fi

  local selected bssid ssid sec
  selected=$(
    fzf "${FZF_THEME[@]}" \
      --prompt=" Wi-Fi ❯ " \
      --border-label=" 󰖩 Wi-Fi Network Selector " \
      --delimiter="│" \
      --header-lines=1 \
      --header-lines-border=bottom \
      --track \
      --id-nth=5 \
      --bind "start,every(2):reload-sync(\"$SELF\" __scan_wifi)" \
      --preview="\"$SELF\" __preview_wifi {5}" \
      --preview-window="right:45%:border-rounded" \
      --preview-label=" 󰤨 Access Point Details " \
      <<< "$("$SELF" __scan_wifi)"
  ) || return 0

  [ -z "$selected" ] && return 0

  bssid=$(echo "$selected" | awk -F'│' '{print $5}' | grep -o -E '([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}' || true)
  [ -z "$bssid" ] && return 0

  ssid=$(nmcli -t -f SSID dev wifi list bssid "$bssid" 2>/dev/null | head -n1)
  sec=$(nmcli -t -f SECURITY dev wifi list bssid "$bssid" 2>/dev/null | head -n1)

  if echo "$selected" | grep -q '● active'; then
    read -r -p "Currently connected to ${ssid:-$bssid}. Disconnect? [y/N]: " disc
    if [[ "$disc" =~ ^[Yy]$ ]]; then
      local wlan_dev
      wlan_dev=$(nmcli -t -f DEVICE,TYPE dev 2>/dev/null | grep ':wifi$' | cut -d: -f1 | head -n1)
      nmcli dev disconnect "$wlan_dev"
    fi
    return 0
  fi

  if [ -n "$ssid" ] && nmcli -t -f NAME connection show 2>/dev/null | grep -Fxq "$ssid"; then
    printf "${C_CYAN}Connecting to saved profile: %s...${C_RESET}\n" "$ssid"
    nmcli connection up id "$ssid" || nmcli dev wifi connect "$bssid"
  else
    if [ -z "$sec" ] || [ "$sec" = "--" ]; then
      printf "${C_GREEN}Connecting to open network: %s...${C_RESET}\n" "${ssid:-$bssid}"
      nmcli dev wifi connect "$bssid"
    else
      printf "${C_CYAN}Secured network: %s (%s)${C_RESET}\n" "${ssid:-$bssid}" "$sec"
      read -r -s -p "Enter Passphrase: " pass
      echo ""
      nmcli dev wifi connect "$bssid" password "$pass"
    fi
  fi
  sleep 1.2
}

manage_hotspot() {
  local active_hs
  active_hs=$(nmcli -t -f NAME,TYPE connection show --active 2>/dev/null | grep ':802-11-wireless' | cut -d: -f1 | grep -iE 'hotspot|ap' || true)

  if [ -n "$active_hs" ]; then
    printf "${C_YELLOW}Active Hotspot running: %s${C_RESET}\n" "$active_hs"
    read -r -p "Deactivate Hotspot? [y/N]: " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
      nmcli connection down id "$active_hs"
      printf "${C_GREEN}Hotspot stopped.${C_RESET}\n"
      sleep 1
    fi
    return 0
  fi

  local hs_choice
  hs_choice=$(
    (
      printf "  ACTION│DESCRIPTION\n"
      printf "  󰤨  Start Saved Hotspot│Bring up configured Hotspot profile\n"
      printf "  󱛃  Create New Hotspot│Configure ad-hoc SSID & WPA2 password\n"
      printf "    Back│Return to main menu\n"
    ) | column -t -s '│' -o ' │ ' | \
    fzf "${FZF_THEME[@]}" \
      --prompt=" Hotspot ❯ " \
      --border-label=" 󰤨 Wi-Fi Access Point Manager " \
      --delimiter="│" \
      --header-lines=1 \
      --header-lines-border=bottom \
      --height=12
  ) || return 0

  case "$hs_choice" in
    *"Start Saved Hotspot"*)
      local saved_hs
      saved_hs=$(
        nmcli -t -f NAME,TYPE connection show 2>/dev/null | grep ':802-11-wireless' | cut -d: -f1 | grep -iE 'hotspot|ap' | \
        fzf "${FZF_THEME[@]}" --prompt=" Profile ❯ " --border-label=" Select Hotspot " --height=10 || true
      )
      if [ -n "$saved_hs" ]; then
        nmcli connection up id "$saved_hs"
        sleep 1
      fi
      ;;
    *"Create New Hotspot"*)
      local wlan_dev hs_ssid hs_pass
      wlan_dev=$(nmcli -t -f DEVICE,TYPE dev 2>/dev/null | grep ':wifi$' | cut -d: -f1 | head -n1)
      read -r -p "Enter Hotspot SSID: " hs_ssid
      [ -z "$hs_ssid" ] && return 0
      read -r -s -p "Enter Hotspot Password (min 8 chars): " hs_pass
      echo ""
      if [ ${#hs_pass} -lt 8 ]; then
        printf "${C_RED}Password must be at least 8 characters.${C_RESET}\n"
        sleep 1.5
        return 0
      fi
      nmcli dev wifi hotspot ifname "$wlan_dev" ssid "$hs_ssid" password "$hs_pass"
      sleep 1.5
      ;;
  esac
}

manage_bluetooth() {
  if ! bluetoothctl show 2>/dev/null | grep -q "Powered: yes"; then
    read -r -p "Bluetooth is powered off. Power on? [Y/n]: " pwr
    if [[ ! "$pwr" =~ ^[Nn]$ ]]; then
      bluetoothctl power on
      sleep 1
    else
      return 0
    fi
  fi

  local bt_choice
  bt_choice=$(
    (
      printf "  ACTION│DESCRIPTION\n"
      printf "  󰂯  Device Manager│Connect, inspect & disconnect devices\n"
      printf "  󰑐  Scan Nearby Devices (5s)│Discover new discoverable Bluetooth hardware\n"
      printf "  󰂲  Power Off Radio│Disable Bluetooth adapter\n"
      printf "    Back│Return to main menu\n"
    ) | column -t -s '│' -o ' │ ' | \
    fzf "${FZF_THEME[@]}" \
      --prompt=" Bluetooth ❯ " \
      --border-label=" 󰂯 Bluetooth Control " \
      --delimiter="│" \
      --header-lines=1 \
      --header-lines-border=bottom \
      --height=12
  ) || return 0

  case "$bt_choice" in
    *"Device Manager"*)
      local selected mac
      selected=$(
        fzf "${FZF_THEME[@]}" \
          --prompt=" Device ❯ " \
          --border-label=" 󰂯 Bluetooth Devices " \
          --delimiter="│" \
          --header-lines=1 \
          --header-lines-border=bottom \
          --track \
          --id-nth=2 \
          --bind "start,every(2):reload-sync(\"$SELF\" __scan_bt)" \
          --preview="\"$SELF\" __preview_bt {2}" \
          --preview-window="right:45%:border-rounded" \
          --preview-label=" 󰂯 Device Info " \
          <<< "$("$SELF" __scan_bt)"
      ) || return 0

      [ -z "$selected" ] && return 0
      mac=$(echo "$selected" | grep -o -E '([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}' || true)
      [ -z "$mac" ] && return 0

      if echo "$selected" | grep -q '● Connected'; then
        printf "${C_YELLOW}Disconnecting %s...${C_RESET}\n" "$mac"
        bluetoothctl disconnect "$mac"
      else
        printf "${C_GREEN}Connecting to %s...${C_RESET}\n" "$mac"
        bluetoothctl connect "$mac"
      fi
      sleep 1.2
      ;;
    *"Scan Nearby Devices"*)
      printf "${C_CYAN}Actively discovering Bluetooth hardware for 5s...${C_RESET}\n"
      bluetoothctl --timeout 5 scan on || true
      sleep 1
      ;;
    *"Power Off Radio"*)
      bluetoothctl power off
      sleep 0.8
      ;;
  esac
}

manage_vpn() {
  local vpns
  vpns=$(nmcli -t -f NAME,TYPE,ACTIVE connection show 2>/dev/null | grep -E ':(vpn|wireguard):' || true)

  if [ -z "$vpns" ]; then
    printf "${C_YELLOW}No VPN or WireGuard connections configured in NetworkManager.${C_RESET}\n"
    read -r -p "Press Enter to return..."
    return 0
  fi

  local table_content selected vpn_name
  table_content=$(
    (
      printf "%b  STATE│TYPE│PROFILE NAME%b\n" "$C_BOLD" "$C_RESET"
      echo "$vpns" | awk -F: -v G="$C_GREEN" -v D="$C_DIM" -v C="$C_CYAN" -v RST="$C_RESET" '{
        st = ($3 == "yes" ? G "● ACTIVE " RST : D "○ INACTIVE" RST)
        printf "  %s│%s%s%s│%s\n", st, C, $2, RST, $1
      }'
    ) | column -t -s '│' -o ' │ '
  )

  selected=$(
    echo "$table_content" | \
    fzf "${FZF_THEME[@]}" \
      --prompt=" VPN ❯ " \
      --border-label=" 󰌘 VPN & WireGuard Tunnels " \
      --delimiter="│" \
      --header-lines=1 \
      --header-lines-border=bottom \
      --height=15
  ) || return 0

  [ -z "$selected" ] && return 0

  vpn_name=$(echo "$selected" | awk -F'│' '{print $3}' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

  if echo "$selected" | grep -q '● ACTIVE'; then
    printf "${C_YELLOW}Deactivating VPN tunnel: %s...${C_RESET}\n" "$vpn_name"
    nmcli connection down id "$vpn_name"
  else
    printf "${C_GREEN}Activating VPN tunnel: %s...${C_RESET}\n" "$vpn_name"
    nmcli connection up id "$vpn_name"
  fi
  sleep 1.2
}

manage_ethernet() {
  local eth_dev
  eth_dev=$(nmcli -t -f DEVICE,TYPE dev 2>/dev/null | grep ':ethernet$' | cut -d: -f1 | head -n1)

  if [ -z "$eth_dev" ]; then
    printf "${C_YELLOW}No Ethernet adapter found on this system.${C_RESET}\n"
    read -r -p "Press Enter to return..."
    return 0
  fi

  local state
  state=$(nmcli -t -f DEVICE,STATE dev 2>/dev/null | grep "^$eth_dev:" | cut -d: -f2)

  printf "${C_BOLD}Interface:${C_RESET} %s  ${C_DIM}|${C_RESET}  ${C_BOLD}Status:${C_RESET} %s\n" "$eth_dev" "${state:-unknown}"
  if [ "$state" = "connected" ]; then
    read -r -p "Disconnect Ethernet? [y/N]: " confirm
    [[ "$confirm" =~ ^[Yy]$ ]] && nmcli dev disconnect "$eth_dev"
  else
    read -r -p "Connect Ethernet? [Y/n]: " confirm
    [[ ! "$confirm" =~ ^[Nn]$ ]] && nmcli dev connect "$eth_dev"
  fi
  sleep 0.8
}

manage_airplane() {
  rfkill toggle all
  sleep 0.5
}

# -----------------------------------------------------------------------------
# Main Dashboard Table Generator
# -----------------------------------------------------------------------------
build_main_table() {
  local rf_state
  if rfkill list all 2>/dev/null | grep -q "Soft blocked: yes"; then
    rf_state="${C_YELLOW}● BLOCKED${C_RESET}"
  else
    rf_state="${C_GREEN}○ Unblocked${C_RESET}"
  fi

  local wifi_radio active_ssid wifi_state
  wifi_radio=$(nmcli -t -f WIFI g 2>/dev/null || echo "off")
  if [ "$wifi_radio" != "enabled" ]; then
    wifi_state="${C_RED}Disabled${C_RESET}"
  else
    active_ssid=$( (nmcli -t -f ACTIVE,SSID dev wifi 2>/dev/null | grep "^yes:" | cut -d: -f2 | head -n1) || true)
    if [ -n "$active_ssid" ]; then
      wifi_state="${C_GREEN}● $active_ssid${C_RESET}"
    else
      wifi_state="${C_DIM}○ Disconnected${C_RESET}"
    fi
  fi

  local bt_state
  if bluetoothctl show 2>/dev/null | grep -q "Powered: yes"; then
    local bt_conn
    bt_conn=$( (bluetoothctl devices Connected 2>/dev/null | cut -d' ' -f3- | head -n1) || true)
    if [ -n "$bt_conn" ]; then
      bt_state="${C_GREEN}● $bt_conn${C_RESET}"
    else
      bt_state="${C_CYAN}○ Powered On${C_RESET}"
    fi
  else
    bt_state="${C_DIM}○ Powered Off${C_RESET}"
  fi

  local eth_dev eth_status eth_state
  eth_dev=$( (nmcli -t -f DEVICE,TYPE dev 2>/dev/null | grep ':ethernet$' | cut -d: -f1 | head -n1) || true)
  if [ -n "$eth_dev" ]; then
    eth_status=$( (nmcli -t -f DEVICE,STATE dev 2>/dev/null | grep "^$eth_dev:" | cut -d: -f2) || true)
    eth_state="${eth_status:-down}"
  else
    eth_state="none"
  fi

  local active_vpn vpn_state
  active_vpn=$( (nmcli -t -f TYPE,NAME connection show --active 2>/dev/null | grep -E '^(vpn|wireguard):' | cut -d: -f2 | paste -sd, -) || true)
  vpn_state="${active_vpn:-Inactive}"

  local idle_state
  if pidof hypridle >/dev/null 2>&1; then
    idle_state="${C_DIM}○ Inactive (Sleep ON)${C_RESET}"
  else
    idle_state="${C_GREEN}● ACTIVE (No Sleep)${C_RESET}"
  fi

  local mic_mute mic_state
  mic_mute=$(pactl get-source-mute @DEFAULT_SOURCE@ 2>/dev/null | awk '{print $2}')
  if [ "$mic_mute" = "yes" ]; then
    mic_state="${C_RED}● MUTED${C_RESET}"
  else
    mic_state="${C_GREEN}○ ACTIVE${C_RESET}"
  fi

  local bat_cap bat_stat bat_state
  bat_cap=$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -n1 || echo "N/A")
  bat_stat=$(cat /sys/class/power_supply/BAT*/status 2>/dev/null | head -n1 || echo "Unknown")
  bat_state="${C_GREEN}${bat_cap}%${C_RESET} (${bat_stat})"

  local sink_mute out_vol out_state
  sink_mute=$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | awk '{print $2}')
  out_vol=$(wpctl get-volume @DEFAULT_SINK@ 2>/dev/null | awk '{print int($2*100)"%"}')
  if [ "$sink_mute" = "yes" ]; then
    out_state="${C_RED}● MUTED${C_RESET}"
  else
    out_state="${C_GREEN}○ ${out_vol:-100%}${C_RESET}"
  fi

  (
    printf "%b  SUBSYSTEM│CURRENT STATE│QUICK ACTION%b\n" "$C_BOLD" "$C_RESET"
    printf "  󰖩  Wi-Fi: Network List│%s│Live Scan & Connect\n" "$wifi_state"
    printf "  󰖪  Wi-Fi: Radio Power│%s│Toggle Adapter\n" "$([ "$wifi_radio" = "enabled" ] && echo "${C_GREEN}Enabled${C_RESET}" || echo "${C_RED}Disabled${C_RESET}")"
    printf "  󰤨  Wi-Fi: Hotspot AP│Ready│Start / Stop AP\n"
    printf "  󰂯  Bluetooth: Devices│%s│Pair & Connect\n" "$bt_state"
    printf "  󰂲  Bluetooth: Radio│%s│Toggle Power\n" "$([ "$bt_state" != "${C_DIM}○ Powered Off${C_RESET}" ] && echo "${C_GREEN}Enabled${C_RESET}" || echo "${C_RED}Disabled${C_RESET}")"
    printf "  󰌘  VPN: WireGuard & VPN│%s│Toggle Tunnels\n" "$vpn_state"
    printf "  󰈀  Ethernet: Wired Link│%s│Toggle Connection\n" "$eth_state"
    printf "  󰀝  Airplane Mode│%s│Toggle All Radios\n" "$rf_state"
    printf "  󰅶  Keep-Awake (Caffeine)│%s│Toggle Sleep Inhibit\n" "$idle_state"
    printf "  󰍬  Microphone│%s│Toggle Mic Mute\n" "$mic_state"
    printf "  󰕾  Speaker / Output│%s│Toggle Audio Mute\n" "$out_state"
    printf "  󰁹  Battery & Power│%s│View Battery Info\n" "$bat_state"
    printf "    Exit│-│Close Dashboard\n"
  ) | column -t -s '│' -o ' │ '
}

if [ "${1:-}" = "__build_main_table" ]; then
  build_main_table
  exit 0
fi

# -----------------------------------------------------------------------------
# Main Application Loop
# -----------------------------------------------------------------------------
main() {
  while true; do
    local menu_choice
    menu_choice=$(
      build_main_table | \
      fzf "${FZF_THEME[@]}" \
        --prompt=" Control ❯ " \
        --border-label=" 󰛳 System & Network Control Center " \
        --delimiter="│" \
        --header-lines=1 \
        --header-lines-border=bottom \
        --preview="\"$SELF\" __preview_main {}" \
        --preview-window="right:42%:border-rounded" \
        --preview-label=" 󰒋 Hardware & Interfaces " \
        --height=20
    ) || exit 0

    case "$menu_choice" in
      *"Wi-Fi: Network List"*)
        manage_wifi
        ;;
      *"Wi-Fi: Radio Power"*)
        curr=$(nmcli -t -f WIFI g 2>/dev/null || echo "disabled")
        [ "$curr" = "enabled" ] && nmcli radio wifi off || nmcli radio wifi on
        sleep 0.4
        ;;
      *"Wi-Fi: Hotspot AP"*)
        manage_hotspot
        ;;
      *"Bluetooth: Devices"*)
        manage_bluetooth
        ;;
      *"Bluetooth: Radio"*)
        if bluetoothctl show 2>/dev/null | grep -q "Powered: yes"; then
          bluetoothctl power off
        else
          bluetoothctl power on
        fi
        sleep 0.4
        ;;
      *"VPN: WireGuard & VPN"*)
        manage_vpn
        ;;
      *"Ethernet: Wired Link"*)
        manage_ethernet
        ;;
      *"Airplane Mode"*)
        manage_airplane
        ;;
      *"Keep-Awake"*|*"Caffeine"*)
        "$HOME/.local/bin/keep-awake"
        sleep 0.4
        ;;
      *"Microphone"*)
        wpctl set-mute @DEFAULT_SOURCE@ toggle
        sleep 0.3
        ;;
      *"Speaker / Output"*)
        wpctl set-mute @DEFAULT_SINK@ toggle
        sleep 0.3
        ;;
      *"Battery & Power"*)
        clear
        python3 "$HOME/.local/bin/battery-info"
        read -r -p "Press Enter to return..."
        ;;
      *"Exit"*|"")
        exit 0
        ;;
    esac
  done
}

main "$@"
